{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTL View",
  "version": "2.3.7",
  "identifier": "com.rtlview.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "نمایشگر راست‌چین RTL View",
        "width": 680,
        "height": 420,
        "minWidth": 360,
        "minHeight": 200,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": true,
        "decorations": false,
        "skipTaskbar": false
      },
      {
        "label": "tray",
        "title": "RTL View Tray",
        "url": "tray.html",
        "width": 240,
        "height": 205,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "headerImage": "assets/installer-header.bmp",
        "sidebarImage": "assets/installer-sidebar.bmp"
      }
    }
  }
}
